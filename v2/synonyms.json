    { "term": "Carotid canal", "aliases": ["Canalis caroticus"], "targets": ["lm:External opening of carotid canal|Temporal bone", "lm:Internal opening of carotid canal|Temporal bone", "Internal carotid artery"], "note": "", "source": { "title": "Wikipedia: Carotid canal", "url": "https://en.wikipedia.org/wiki/Carotid_canal" }, "reviewed": false },
    { "term": "Mastoiditis", "aliases": [], "targets": ["lm:Mastoid process|Temporal bone"], "note": "", "source": { "title": "Wikipedia: Mastoiditis", "url": "https://en.wikipedia.org/wiki/Mastoiditis" }, "reviewed": false },
    { "term": "TMJ", "aliases": ["temporomandibular joint", "Kiefergelenk"], "targets": ["Articular disc of temporomandibular joint", "lm:Mandibular fossa|Temporal bone", "lm:Condylar process (head of mandible)|Mandible"], "note": "", "source": { "title": "Wikipedia: Temporomandibular joint", "url": "https://en.wikipedia.org/wiki/Temporomandibular_joint" }, "reviewed": false },
    { "term": "Parotid tumour", "aliases": ["pleomorphic adenoma", "Warthin tumour"], "targets": ["Parotid gland", "Facial nerve (VII)"], "note": "CN VII divides the gland into superficial and deep lobe.", "source": { "title": "Wikipedia: Parotid gland", "url": "https://en.wikipedia.org/wiki/Parotid_gland" }, "reviewed": false },
    { "term": "Wallenberg syndrome", "aliases": ["lateral medullary syndrome", "PICA infarct"], "targets": ["Medulla oblongata", "Vertebral artery"], "note": "Usually vertebral artery or PICA occlusion.", "source": { "title": "Wikipedia: Lateral medullary syndrome", "url": "https://en.wikipedia.org/wiki/Lateral_medullary_syndrome" }, "reviewed": false },
