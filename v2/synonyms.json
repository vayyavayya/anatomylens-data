{
  "about": "Clinical-synonym search table for AnatomyLens. Edit freely on GitHub; the app reads it from @main (jsDelivr cache: purge or wait up to 12 h). targets = model ids without side suffix (\"Thalamus\") or landmark ids (\"lm:<name>|<bone>\"). Every entry cites a source. reviewed=false until Ajit has checked it.",
  "version": 1,
  "entries": [
    { "term": "Bell's palsy", "aliases": ["Bell palsy", "facial palsy", "Fazialisparese"], "targets": ["Facial nerve (VII)"], "note": "Idiopathic peripheral CN VII palsy; enhancement of the labyrinthine/geniculate segment on MRI.", "source": { "title": "Wikipedia: Bell's palsy", "url": "https://en.wikipedia.org/wiki/Bell%27s_palsy" }, "reviewed": false },
    { "term": "Broca's area", "aliases": ["Broca", "motor speech area"], "targets": ["Opercular part of inferior frontal gyrus", "Triangular part of inferior frontal gyrus"], "note": "Pars opercularis + pars triangularis of the (usually left) inferior frontal gyrus.", "source": { "title": "Wikipedia: Broca's area", "url": "https://en.wikipedia.org/wiki/Broca%27s_area" }, "reviewed": false },
    { "term": "Wernicke's area", "aliases": ["Wernicke"], "targets": ["Superior temporal gyrus (Lateral part)"], "note": "Posterior superior temporal gyrus of the dominant hemisphere.", "source": { "title": "Wikipedia: Wernicke's area", "url": "https://en.wikipedia.org/wiki/Wernicke%27s_area" }, "reviewed": false },
    { "term": "M1", "aliases": ["M1 segment", "MCA M1", "sphenoidal segment"], "targets": ["Middle cerebral artery (M1-segment)"], "note": "Horizontal (sphenoidal) MCA segment up to the limen insulae; lenticulostriate arteries arise here.", "source": { "title": "Wikipedia: Middle cerebral artery", "url": "https://en.wikipedia.org/wiki/Middle_cerebral_artery" }, "reviewed": false },
    { "term": "M2", "aliases": ["M2 segment", "insular segment"], "targets": ["Insular branches of middle cerebral artery (M2)"], "note": "Insular MCA segment.", "source": { "title": "Wikipedia: Middle cerebral artery", "url": "https://en.wikipedia.org/wiki/Middle_cerebral_artery" }, "reviewed": false },
    { "term": "M3", "aliases": ["M3 segment", "opercular segment"], "targets": ["Middle cerebral artery (M3-segment)"], "note": "Opercular MCA segment.", "source": { "title": "Wikipedia: Middle cerebral artery", "url": "https://en.wikipedia.org/wiki/Middle_cerebral_artery" }, "reviewed": false },
    { "term": "MCA", "aliases": ["Arteria cerebri media", "A. cerebri media"], "targets": ["Middle cerebral artery (M1-segment)"], "note": "Opens the MCA tree at its M1 segment.", "source": { "title": "Wikipedia: Middle cerebral artery", "url": "https://en.wikipedia.org/wiki/Middle_cerebral_artery" }, "reviewed": false },
    { "term": "ACA", "aliases": ["A1", "A2", "Arteria cerebri anterior"], "targets": ["Anterior cerebral artery"], "note": "A1 = precommunicating, A2 = postcommunicating segment.", "source": { "title": "Wikipedia: Anterior cerebral artery", "url": "https://en.wikipedia.org/wiki/Anterior_cerebral_artery" }, "reviewed": false },
    { "term": "PCA", "aliases": ["P1", "P2", "Arteria cerebri posterior"], "targets": ["Posterior cerebral artery"], "note": "P1 = precommunicating segment from the basilar tip to the PComm.", "source": { "title": "Wikipedia: Posterior cerebral artery", "url": "https://en.wikipedia.org/wiki/Posterior_cerebral_artery" }, "reviewed": false },
    { "term": "AComm", "aliases": ["Acom", "ACoA", "anterior communicating"], "targets": ["Anterior communicating artery"], "note": "Most common site of intracranial aneurysms.", "source": { "title": "Wikipedia: Anterior communicating artery", "url": "https://en.wikipedia.org/wiki/Anterior_communicating_artery" }, "reviewed": false },
    { "term": "PComm", "aliases": ["Pcom", "PCoA", "posterior communicating"], "targets": ["Posterior communicating artery"], "note": "PComm aneurysm can compress CN III.", "source": { "title": "Wikipedia: Posterior communicating artery", "url": "https://en.wikipedia.org/wiki/Posterior_communicating_artery" }, "reviewed": false },
    { "term": "Circle of Willis", "aliases": ["Circulus arteriosus cerebri"], "targets": ["Anterior communicating artery", "Anterior cerebral artery", "Internal carotid artery", "Posterior communicating artery", "Posterior cerebral artery"], "note": "Opens the components; complete in a minority of people.", "source": { "title": "Wikipedia: Circle of Willis", "url": "https://en.wikipedia.org/wiki/Circle_of_Willis" }, "reviewed": false },
    { "term": "Heschl's gyrus", "aliases": ["Heschl", "primary auditory cortex"], "targets": ["Transverse temporal gyri"], "note": "", "source": { "title": "Wikipedia: Transverse temporal gyrus", "url": "https://en.wikipedia.org/wiki/Transverse_temporal_gyrus" }, "reviewed": false },
    { "term": "Motor strip", "aliases": ["primary motor cortex", "M1 cortex", "Gyrus praecentralis"], "targets": ["Precentral gyrus"], "note": "Hand knob = omega-shaped segment of the precentral gyrus.", "source": { "title": "Wikipedia: Primary motor cortex", "url": "https://en.wikipedia.org/wiki/Primary_motor_cortex" }, "reviewed": false },
    { "term": "Primary somatosensory cortex", "aliases": ["S1", "sensory strip"], "targets": ["Postcentral gyrus"], "note": "", "source": { "title": "Wikipedia: Postcentral gyrus", "url": "https://en.wikipedia.org/wiki/Postcentral_gyrus" }, "reviewed": false },
    { "term": "Visual cortex", "aliases": ["V1", "striate cortex", "primary visual cortex"], "targets": ["Calcarine sulcus", "Cuneus", "Lingual gyrus"], "note": "V1 lines the calcarine sulcus (cuneus above, lingual gyrus below).", "source": { "title": "Wikipedia: Visual cortex", "url": "https://en.wikipedia.org/wiki/Visual_cortex" }, "reviewed": false },
    { "term": "Basal ganglia", "aliases": ["Stammganglien"], "targets": ["Caudate nucleus", "Putamen", "Globus pallidus"], "note": "", "source": { "title": "Wikipedia: Basal ganglia", "url": "https://en.wikipedia.org/wiki/Basal_ganglia" }, "reviewed": false },
    { "term": "Striatum", "aliases": ["corpus striatum", "dorsal striatum"], "targets": ["Caudate nucleus", "Putamen"], "note": "", "source": { "title": "Wikipedia: Striatum", "url": "https://en.wikipedia.org/wiki/Striatum" }, "reviewed": false },
    { "term": "Lenticular nucleus", "aliases": ["Nucleus lentiformis"], "targets": ["Lentiform nucleus"], "note": "Putamen + globus pallidus.", "source": { "title": "Wikipedia: Lentiform nucleus", "url": "https://en.wikipedia.org/wiki/Lentiform_nucleus" }, "reviewed": false },
    { "term": "Papez circuit", "aliases": ["medial limbic circuit"], "targets": ["Hippocampus", "Fornix", "Mamillary body", "Thalamus"], "note": "Hippocampus → fornix → mamillary body → anterior thalamus → cingulum.", "source": { "title": "Wikipedia: Papez circuit", "url": "https://en.wikipedia.org/wiki/Papez_circuit" }, "reviewed": false },
    { "term": "Mesial temporal sclerosis", "aliases": ["hippocampal sclerosis", "Ammonshornsklerose"], "targets": ["Hippocampus"], "note": "", "source": { "title": "Wikipedia: Hippocampal sclerosis", "url": "https://en.wikipedia.org/wiki/Hippocampal_sclerosis" }, "reviewed": false },
    { "term": "Aqueduct of Sylvius", "aliases": ["cerebral aqueduct", "Aquaeductus mesencephali"], "targets": ["Aqueduct of midbrain"], "note": "Aqueductal stenosis → triventricular hydrocephalus.", "source": { "title": "Wikipedia: Cerebral aqueduct", "url": "https://en.wikipedia.org/wiki/Cerebral_aqueduct" }, "reviewed": false },
    { "term": "Pituitary gland", "aliases": ["hypophysis", "Hypophyse"], "targets": ["Adenohypophysis", "Neurohypophysis"], "note": "Posterior pituitary bright spot on T1 = neurohypophysis.", "source": { "title": "Wikipedia: Pituitary gland", "url": "https://en.wikipedia.org/wiki/Pituitary_gland" }, "reviewed": false },
    { "term": "Sella", "aliases": ["sella turcica", "Türkensattel"], "targets": ["lm:Sella turcica|Sphenoid bone"], "note": "", "source": { "title": "Wikipedia: Sella turcica", "url": "https://en.wikipedia.org/wiki/Sella_turcica" }, "reviewed": false },
    { "term": "Clivus", "aliases": ["basiocciput"], "targets": ["lm:Basilar part of occipital bone|Occipital bone"], "note": "Clivus = basi-occiput + posterior sphenoid body.", "source": { "title": "Wikipedia: Clivus (anatomy)", "url": "https://en.wikipedia.org/wiki/Clivus_(anatomy)" }, "reviewed": false },
    { "term": "Odontoid process", "aliases": ["dens", "Dens axis", "odontoid"], "targets": ["lm:Dens axis|Axis (C2)"], "note": "", "source": { "title": "Wikipedia: Axis (anatomy)", "url": "https://en.wikipedia.org/wiki/Axis_(anatomy)" }, "reviewed": false },
    { "term": "Jefferson fracture", "aliases": ["C1 burst fracture"], "targets": ["Atlas (C1)"], "note": "Burst fracture of the atlas ring.", "source": { "title": "Wikipedia: Jefferson fracture", "url": "https://en.wikipedia.org/wiki/Jefferson_fracture" }, "reviewed": false },
    { "term": "Hangman's fracture", "aliases": ["traumatic spondylolisthesis of the axis"], "targets": ["Axis (C2)"], "note": "Bilateral pars interarticularis fracture of C2.", "source": { "title": "Wikipedia: Hangman's fracture", "url": "https://en.wikipedia.org/wiki/Hangman%27s_fracture" }, "reviewed": false },
    { "term": "SSS", "aliases": ["superior sagittal sinus", "Sinus sagittalis superior"], "targets": ["Superior sagittal sinus"], "note": "", "source": { "title": "Wikipedia: Superior sagittal sinus", "url": "https://en.wikipedia.org/wiki/Superior_sagittal_sinus" }, "reviewed": false },
    { "term": "Sinus rectus", "aliases": ["straight sinus"], "targets": ["Straight sinus"], "note": "", "source": { "title": "Wikipedia: Straight sinus", "url": "https://en.wikipedia.org/wiki/Straight_sinus" }, "reviewed": false },
    { "term": "Sinus venous thrombosis", "aliases": ["Sinusvenenthrombose", "CVST", "dural sinus thrombosis"], "targets": ["Superior sagittal sinus", "Transverse sinus", "Sigmoid sinus", "Straight sinus"], "note": "Most commonly superior sagittal and transverse sinus.", "source": { "title": "Wikipedia: Cerebral venous sinus thrombosis", "url": "https://en.wikipedia.org/wiki/Cerebral_venous_sinus_thrombosis" }, "reviewed": false },
    { "term": "Cavernous sinus", "aliases": ["Sinus cavernosus"], "targets": ["Cavernous sinus"], "note": "Contains ICA and CN VI; III, IV, V1, V2 in its lateral wall.", "source": { "title": "Wikipedia: Cavernous sinus", "url": "https://en.wikipedia.org/wiki/Cavernous_sinus" }, "reviewed": false },
    { "term": "Trigeminal neuralgia", "aliases": ["tic douloureux", "Trigeminusneuralgie"], "targets": ["Trigeminal nerve (V)"], "note": "Look for neurovascular conflict at the root entry zone.", "source": { "title": "Wikipedia: Trigeminal neuralgia", "url": "https://en.wikipedia.org/wiki/Trigeminal_neuralgia" }, "reviewed": false },
    { "term": "Vestibular schwannoma", "aliases": ["acoustic neuroma", "Akustikusneurinom", "CPA tumour"], "targets": ["Vestibulocochlear nerve (VIII)", "lm:Internal acoustic opening (porus of internal acoustic meatus)|Temporal bone"], "note": "Arises in the IAC, extends through the porus into the CPA.", "source": { "title": "Wikipedia: Vestibular schwannoma", "url": "https://en.wikipedia.org/wiki/Vestibular_schwannoma" }, "reviewed": false },
    { "term": "Hemifacial spasm", "aliases": [], "targets": ["Facial nerve (VII)"], "note": "Vascular compression at the CN VII root exit zone.", "source": { "title": "Wikipedia: Hemifacial spasm", "url": "https://en.wikipedia.org/wiki/Hemifacial_spasm" }, "reviewed": false },
    { "term": "Third nerve palsy", "aliases": ["oculomotor palsy", "Okulomotoriusparese"], "targets": ["Oculomotor nerve (III)", "Posterior communicating artery"], "note": "Pupil-involving palsy → exclude PComm aneurysm.", "source": { "title": "Wikipedia: Oculomotor nerve palsy", "url": "https://en.wikipedia.org/wiki/Oculomotor_nerve_palsy" }, "reviewed": false },
    { "term": "Sixth nerve palsy", "aliases": ["abducens palsy", "Abduzensparese"], "targets": ["Abducens nerve (VI)"], "note": "Long intracranial course (Dorello's canal) → false localising sign.", "source": { "title": "Wikipedia: Sixth nerve palsy", "url": "https://en.wikipedia.org/wiki/Sixth_nerve_palsy" }, "reviewed": false },
    { "term": "Gradenigo syndrome", "aliases": ["petrous apicitis"], "targets": ["lm:Apex of petrous part|Temporal bone", "Abducens nerve (VI)", "Trigeminal nerve (V)"], "note": "Petrous apicitis + CN VI palsy + V1 pain.", "source": { "title": "Wikipedia: Gradenigo's syndrome", "url": "https://en.wikipedia.org/wiki/Gradenigo%27s_syndrome" }, "reviewed": false },
